{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src"]
}
